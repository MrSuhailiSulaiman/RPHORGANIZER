{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/jadual/analyze/route.ts": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/tesseract.js/**,node_modules/tesseract.js-core/**,node_modules/wasm-feature-detect/**,vendor/tessdata/**}"
    },
    "src/app/api/dskp/analyze/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/rph/generate/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/rph/tahun/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/padam-rph.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
